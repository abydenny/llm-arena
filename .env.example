# ==============================================================================
# LLM Arena & Judge - Environment Variables
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# 1. PIN Authentication (Required)
# Enter any 4-8 digit numeric PIN for logging into the app
APP_PIN=1234

# 2. OpenRouter API Key (Required for LLMs & Judge)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter site referrer for rankings & analytics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="LLM Arena & Multi-Model Judge"

# 3. Supabase Credentials (Required for cloud persistence)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. LLM Judge Configuration
# Model ID used to evaluate and critique responses
# Recommended: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, or google/gemini-2.0-flash-exp:free
JUDGE_MODEL=openai/gpt-4o-mini

# 5. Session Secret for PIN Authentication Cookie Signing
PIN_SESSION_SECRET=super_secret_llm_arena_session_salt_2026
